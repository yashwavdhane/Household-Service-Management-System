# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/household_service_db
# OR Atlas: MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── JWT (Phase 2) ────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
